  "components": {
    "schemas": {
      "BookingDetailDTO": {
        "required": [
          "customerUserName",
          "paymentMethod"
        ],
        "type": "object",
        "properties": {
          "customerUserName": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "customerName": {
            "maxLength": 20,
            "minLength": 2,
            "type": "string",
            "nullable": true
          },
          "customerSurname": {
            "maxLength": 30,
            "minLength": 2,
            "type": "string",
            "nullable": true
          },
          "address": {
            "maxLength": 50,
            "minLength": 5,
            "type": "string",
            "nullable": true
          },
          "paymentMethod": {
            "$ref": "#/components/schemas/PaymentMethodTypes"
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          },
          "bookingItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingItemDTO"
            },
            "nullable": true
          },
          "totalPrice": {
            "type": "number",
            "format": "double",
            "readOnly": true
          },
          "totalNumberOfDays": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "BookingForCreateDTO": {
        "required": [
