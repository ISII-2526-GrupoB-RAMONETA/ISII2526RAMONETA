@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager navigation
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreateBooking> logger
@inject BookingStateContainer bookingState

@page "/booking/createbooking"

@attribute [Authorize]
<h3>CreateBooking</h3>

@* booking is the object that will be edited thanks to the form *@
<EditForm Model="booking" OnValidSubmit="OpenDialog">
    <div class="row">

        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="booking.CustomerName" class="form-control" id="Name" />
                
                <label for="Name">Name </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="booking.CustomerSurname" class="form-control" id="Surname" />
                
                <label for="Surname">Surname </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="booking.Address" class="form-control" id="AddressCreate" />

                <label for="DeliveryAddress">Delivery Address</label>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-md">
                <div class="form-floating">
                    @*a dropdown for selecting the payment method*@
                    <InputSelect class="form-select" @bind-Value="@booking.PaymentMethod" id="PaymentMethodCreate">
                        <option value="@PaymentMethodTypes.TarjetaCredito" default>TarjetaCredito</option>
                        <option value="@PaymentMethodTypes.PayPal">PayPal</option>
                        <option value="@PaymentMethodTypes.Efectivo">Efectivo</option>
                    </InputSelect>
                    <label for="PaymentMethod">Payment Method</label>
                </div>
            </div>


        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="booking.PhoneNumber" class="form-control" id="PhoneNumberCreate" />
                <label for="PhoneNumber">Phone Number</label>
            </div>
        </div>

    </div>



        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to book the maintenances*@
                <button class="btn btn-primary" type="submit" id="Submit">
                    Book your maintenances
                </button>
            </div>
        </div>

    </div>

    <h4>Booking detail</h4>
    <p>
        <b> Total price:</b> <span id="TotalPriceCreate">@TotalPrice €</span>
        <b> Total number of days:</b> <span id="TotalDaysCreate">@TotalDays </span>
        <button class="btn btn-outline-primary" type="submit" @onclick="ModifyBookingItems" id="ModifyMaintenances">
            Modify maintenances
        </button>
    </p>



    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfBookingItems">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Number Of Days</th>
                    <th>Comment</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in booking.BookingItems)
                {
                    <tr id="MaintenanceData_@item.Name">
                        <td>@item.Name</td>
                        <td>@item.Price</td>
                        <td>@item.NumberOfDays</td>
                        <td><InputText @bind-Value="item.Comment" class="form-control" id="@($"comment_{item.MaintenanceId}")" /></td>
                        
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@*a modal popup dialog for checking if user wants to proceed to book*@
@if (DialogIsOpen)
{
    <Dialog Caption="Booking maintenances"
    Message="Do you want to proceed to book the selected maintenances?"
    OnClose="@OnDialogClose"
    Type=Dialog.Category.SaveNot>
    </Dialog>
}


@code {
    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool DialogIsOpen;
    private BookingForCreateDTO booking => bookingState.Booking;

    private decimal TotalPrice
    {
        get
        {

            double price = booking.BookingItems.Sum(ri => ri.Price);
            return Convert.ToDecimal(price);
        }
    }

    private decimal TotalDays
    {
        get
        {

            double days = booking.BookingItems.Sum(ri => ri.NumberOfDays);
            return Convert.ToInt16(days);
        }
    }

    private void ModifyBookingItems()
    {
        navigation.NavigateTo("/booking/selectmaintenancesforbooking");
    }



    private void OpenDialog()
    {

        DialogIsOpen = true;
    }



    protected override async Task OnInitializedAsync()
    {



        foreach (var item in booking.BookingItems)
        {
            if (item.Comment == null)
                item.Comment = "";
        }


        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    booking.CustomerUserName = user.Identity.Name;
                }
            }
            booking.Address = booking.Address == null ? "" : booking.Address;
            booking.CustomerName = booking.CustomerName == null ? "" : booking.CustomerName;
            booking.CustomerSurname = booking.CustomerSurname == null ? "" : booking.CustomerSurname;
            
            booking.PhoneNumber = booking.PhoneNumber == null ? "" : booking.PhoneNumber;

        }
    }


    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }


    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid
            if (booking.BookingItems.Count > 0)
            {
                try
                {
                    var booked = await apiclient.CreateBookingAsync(booking);
                    bookingState.BookingProcessed();
                    navigation.NavigateTo($"/booking/detailbooking/?BookingID={booked.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error while processing your request, please try again later!";

                }


            }
        }
    }

}
